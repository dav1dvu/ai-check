# Google Gemini API Key (Serverless Only - DO NOT prefix with NEXT_PUBLIC_)
# Isolated to Vercel Serverless environment for high security
GEMINI_API_KEY="your_gemini_api_key_here"

# Configured Gemini Model (Defaults to gemini-3.8-flash, auto-falls back to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.8-flash"

# Google Search Grounding Tool
# Note: On Google AI Studio Free Tier, leave "false" (or unset) to avoid 429 RESOURCE_EXHAUSTED.
# Only set to "true" if you have a Google Cloud project with Billing enabled.
ENABLE_GROUNDING="false"
